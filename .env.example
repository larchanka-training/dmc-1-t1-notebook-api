APP_NAME=JS Notebook
APP_ENV=dev
API_PREFIX=/api/v1
DATABASE_URL=postgresql://admin:changeme@localhost:5432/wiki
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=

# Auth / JWT — MUST be overridden in production
JWT_SECRET=dev-jwt-secret-replace-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_SECONDS=900
SESSION_TTL_SECONDS=604800
COOKIE_DOMAIN=.notebook.com

# OpenTelemetry → Aspire Dashboard
# false = OTel выключен (по умолчанию, безопасно для запуска без Aspire)
OTEL_ENABLED=false
# В Docker Compose (сервис → сервис): http://aspire-dashboard:18889
# Локально (вне Docker):               http://localhost:4317
OTEL_ENDPOINT=http://aspire-dashboard:18889
OTEL_SERVICE_NAME=dmc-1-t1-notebook-api

# AWS Bedrock — AI code generation
# In ECS the task IAM role provides credentials automatically.
# Locally, configure AWS credentials via ~/.aws/credentials or environment variables.
# Uses Amazon Nova models by default — no approval required, available in all commercial regions.
# To switch models, change BEDROCK_MODEL_ID (Converse API works with Nova, Llama, Mistral, Claude).
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
BEDROCK_REGION=eu-north-1

# AI rate limiting (per user, in-memory sliding window)
AI_RATE_LIMIT_RPM=10
AI_RATE_LIMIT_RPD=100
AI_MAX_PROMPT_CHARS=32000

# Настройки системы логирования
LOG_LEVEL=DEBUG
# В консоли видим логи от уровня DEBUG
LOG_LEVEL_CONSOLE=DEBUG
# Включить/выключить логирование в файлы
ENABLE_FILE_LOGGING=true
# В файлы пишутся логи от уровня INFO (для экономии места), новый файл (на текущую дату) создаётся в 00:00 UTC
LOG_LEVEL_FILE=INFO
# Количество дней хранения логов (то есть сколько файлов логов может храниться локально)
LOG_RETENTION_DAYS=14
